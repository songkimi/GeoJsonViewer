<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GeoJsonViewer</RootNamespace>
    <AssemblyName>GeoJsonViewer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- 示例数据随程序复制到输出目录，「打开…」对话框的默认目录就是它。
       Content 自带 CopyToOutputDirectory，语义也比 None 更准（这些 .geojson 是运行时要读的数据）。 -->
  <ItemGroup>
    <Content Include="Samples\**\*.geojson" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TestData 下的一次性探针工程自带 Program.cs 和 obj\ 生成文件，SDK 会把它们一起编进来，
       导致两份 AssemblyInfo 冲突（CS0579 特性重复），所以整目录排除。 -->
  <ItemGroup>
    <Compile Remove="TestData\**\*.cs" />
    <EmbeddedResource Remove="TestData\**\*" />
    <None Remove="TestData\**\*" />
  </ItemGroup>

  <!-- shapefile 解析用 NetTopologySuite.IO.Esri.Shapefile：纯托管、MIT、读写都支持，不需要 GDAL 那样的本地二进制依赖。
       版本锁到次版本号，避免浮动版本让同一份代码过段时间就编不过。 -->
  <ItemGroup>
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" Version="1.2.0" />
    <PackageReference Include="ProjNET" Version="2.1.0" />
  </ItemGroup>

</Project>
