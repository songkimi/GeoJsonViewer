<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GeoJsonViewer</RootNamespace>
    <AssemblyName>GeoJsonViewer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!--
    测试数据跟着程序一起复制到输出目录，"打开…"对话框的默认目录就是它。

    为什么用 Content 而不是 None：
      · Content 是"要跟程序一起发出去的文件"，天生带 CopyToOutputDirectory，
        写少一点、意图也更准；
      · None 是"纯粹放在那儿、不参与构建"的文件，让它拷贝是额外拧的开关。
      两者这里都能跑，选 Content 是因为它描述的就是我们真正想表达的意思
      （这些 .geojson 是程序运行时要读的数据，不是源码之外的杂物）。
  -->
  <ItemGroup>
    <Content Include="Samples\**\*.geojson" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
